#!/usr/bin/env bash
set -euo pipefail

PROGRAM=${0##*/}
CONFIG_FILE=.easy-ssh.conf
IGNORE_FILE=.easy-ssh-ignore
LOG_FILE=.easy-ssh-log
STATUS_FILE=.easy-ssh-status
SIZE_WARN_KB=${EASY_SSH_SIZE_WARN_KB:-512000}
SSH_CONNECT_TIMEOUT=${EASY_SSH_CONNECT_TIMEOUT:-30}
SSH_CONTROL_PERSIST=${EASY_SSH_CONTROL_PERSIST:-10m}
SSH_CONTROL_DIR=${EASY_SSH_CONTROL_DIR:-}
LOG_LINES=${EASY_SSH_LOG_LINES:-50}
SSH_OPTS=()

remote_name=""
host=""
remote_dir=""
remote_dir_real=""
config_remote=""
DEFAULT_EXCLUDES=(.git .venv "$CONFIG_FILE" "$IGNORE_FILE")
CLEANABLE_DEFAULT_EXCLUDES=(.git .venv)
RSYNC_ARGS=()
RSYNC_SIZE_ARGS=()
RSYNC_SSH=""

usage() {
    cat <<EOF
Usage: $PROGRAM [--remote NAME] <command> [arguments]

Commands:
  init                         Configure a project remote
  push [--clean] [--force]    Sync local files to the remote
  run "<cmd>"                  Run a trivial read-only command and wait
  submit "<cmd>"               Launch a durable background job
  logs                         Show recent submitted-job output
  monitor                      Stream submitted-job output
  status                       Check SSH and submitted-job state
  pull <path>                  Fetch a path from the remote project
  clean [--force]              Preview or remove remote-only files

Options:
  -r, --remote NAME            Select a named remote from $CONFIG_FILE
  -h, --help [TOPIC]           Show overview or focused guidance

Focused help (progressive disclosure):
  $PROGRAM --help getting-started
  $PROGRAM --help jobs
  $PROGRAM --help configuration
  $PROGRAM --help troubleshooting
  $PROGRAM --help skill          Emit the complete installable Agent Skill
EOF
}

help_getting_started() {
    cat <<EOF
Getting started

1. Confirm that ssh and rsync are available:

     command -v ssh
     command -v rsync

   Debian/Ubuntu: sudo apt-get install openssh-client rsync
   macOS: ssh is included; install rsync with 'brew install rsync' if needed.

   If easy-ssh is missing, download it before installing (never pipe to a shell):

     Repository: https://github.com/exAClior/easy-ssh
     (
       set -eu
       tmp=\$(mktemp)
       trap 'rm -f "\$tmp"' EXIT
       curl -fL https://raw.githubusercontent.com/exAClior/easy-ssh/main/easy-ssh -o "\$tmp"
       bash -n "\$tmp"
       mkdir -p "\$HOME/.local/bin"
       install -m 0755 "\$tmp" "\$HOME/.local/bin/easy-ssh"
     )
     export PATH="\$HOME/.local/bin:\$PATH"

   Persist that PATH export in your shell startup file if necessary.
2. In the local project, run:

     $PROGRAM init
     $PROGRAM status

3. Submit substantive work durably:

     $PROGRAM submit "python train.py"
     $PROGRAM monitor
     $PROGRAM status

Use '$PROGRAM run' only for trivial read-only probes that finish in about
10 seconds. See '$PROGRAM --help jobs' for the durability model.
EOF
}

help_jobs() {
    cat <<EOF
Remote jobs

  $PROGRAM submit "<cmd>"   Sync, launch with nohup, and return immediately
  $PROGRAM monitor          Stream the durable log; Ctrl+C only detaches
  $PROGRAM logs             Show the latest log lines
  $PROGRAM status           Report running or finished state and exit code

Detached jobs continue if SSH or the invoking terminal disconnects. A failed
monitoring connection does not mean the job stopped. Do not repeat an uncertain
submission until '$PROGRAM status' confirms whether a job is already running.

'$PROGRAM run' is intentionally limited to short, read-only probes. Builds,
tests, downloads, training, and commands that write files belong in 'submit'.
EOF
}

help_configuration() {
    cat <<EOF
Configuration

$CONFIG_FILE supports a default remote:

  host='a800'
  remote_dir='~/projects/my-project'

or named sections selected with '--remote NAME':

  [a800]
  host='a800'
  remote_dir='~/projects/my-project'

$IGNORE_FILE adds rsync exclusions. .git, .venv, $CONFIG_FILE, and
$IGNORE_FILE are always excluded.

Environment:
  EASY_SSH_SIZE_WARN_KB       Sync-size refusal threshold (default: 512000)
  EASY_SSH_CONNECT_TIMEOUT    SSH connect/banner timeout (default: 30 seconds)
  EASY_SSH_CONTROL_PERSIST    Master connection lifetime (default: 10m)
  EASY_SSH_CONTROL_DIR        Control socket directory
                              (default: ~/.ssh/easy-ssh-control)
  EASY_SSH_LOG_LINES          Lines shown by logs (default: 50)

easy-ssh uses OpenSSH ControlMaster=auto with ControlPersist so status, logs,
rsync, and launch operations can reuse one authenticated connection. The socket
directory is private to the local user.
EOF
}

help_troubleshooting() {
    cat <<EOF
Troubleshooting

  SSH connection failed
    Verify 'ssh <host> true' works non-interactively. Proxied or loaded hosts may
    need a larger EASY_SSH_CONNECT_TIMEOUT; the default is 30 seconds.

  Connection timed out during banner exchange
    The network/proxy/sshd path did not answer before the timeout. Retry status
    after a short delay. Detached jobs continue independently.

  Job already running
    Inspect '$PROGRAM status' and '$PROGRAM logs'. Do not resubmit blindly.

  Sync payload too large
    Add build outputs, datasets, or caches to $IGNORE_FILE, or use --force only
    after checking the payload.

  Suspected stale multiplexed connection
    OpenSSH normally replaces stale sockets automatically. To isolate a problem,
    set EASY_SSH_CONTROL_DIR to a fresh private directory for one invocation.
EOF
}

print_agent_skill() {
    local source=${BASH_SOURCE[0]}
    local content="" line emitting=0 found_begin=0 found_end=0

    [[ -r $source ]] || die "cannot read embedded Agent Skill from $source"

    while IFS= read -r line || [[ -n $line ]]; do
        if [[ $line == '__EASY_SSH_SKILL_BEGIN__' ]]; then
            emitting=1
            found_begin=1
            continue
        fi
        if [[ $line == '__EASY_SSH_SKILL_END__' ]]; then
            found_end=1
            break
        fi
        (( emitting )) && content+="$line"$'\n'
    done < "$source"

    (( found_begin && found_end )) || die "embedded Agent Skill markers are incomplete"
    printf '%s' "$content"
}

show_help() {
    local topic=${1:-overview}

    case "$topic" in
        overview|commands) usage ;;
        getting-started) help_getting_started ;;
        jobs) help_jobs ;;
        configuration|config) help_configuration ;;
        troubleshooting) help_troubleshooting ;;
        skill|agent-skill) print_agent_skill ;;
        *) die "unknown help topic '$topic' (try '$PROGRAM --help')" ;;
    esac
}

info() {
    printf '%s\n' "$*"
}

warn() {
    printf 'warning: %s\n' "$*" >&2
}

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

trim() {
    local value="$1"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

strip_outer_quotes() {
    local value="$1"
    local len=${#value}
    if [[ $len -ge 2 ]]; then
        local last=${value:$((len-1)):1}
        if [[ ${value:0:1} == "'" && $last == "'" ]]; then
            value=${value:1:$((len-2))}
        elif [[ ${value:0:1} == '"' && $last == '"' ]]; then
            value=${value:1:$((len-2))}
        fi
    fi
    printf '%s' "$value"
}

parse_config_value() {
    local value
    value=$(trim "$1")
    value=${value%%#*}
    value=$(trim "$value")
    value=$(strip_outer_quotes "$value")
    printf '%s' "$value"
}

validate_remote_name() {
    local name="$1"

    [[ -n $name ]] || die "remote name is required"
    [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid remote name '$name' (use letters, numbers, dot, underscore, or dash)"
}

config_has_sections() {
    local line header len

    [[ -f "$CONFIG_FILE" ]] || return 1

    while IFS= read -r line || [[ -n $line ]]; do
        line=$(trim "$line")
        [[ -z $line || ${line:0:1} == '#' ]] && continue

        header=${line%%#*}
        header=$(trim "$header")
        [[ ${header:0:1} == '[' ]] || continue

        len=${#header}
        [[ $len -ge 3 && ${header:$((len-1)):1} == ']' ]] && return 0
    done < "$CONFIG_FILE"

    return 1
}

write_named_remote_config() {
    local name="$1"
    local input_host="$2"
    local input_remote_dir="$3"
    local tmp line trimmed header len section skip=0

    tmp=$(mktemp "${CONFIG_FILE}.XXXXXX") || die "failed to create temporary config"

    if [[ -f "$CONFIG_FILE" ]]; then
        while IFS= read -r line || [[ -n $line ]]; do
            trimmed=$(trim "$line")
            header=${trimmed%%#*}
            header=$(trim "$header")

            if [[ ${header:0:1} == '[' ]]; then
                len=${#header}
                if [[ $len -ge 3 && ${header:$((len-1)):1} == ']' ]]; then
                    section=${header:1:$((len-2))}
                    section=$(trim "$section")
                    if [[ $section == "$name" ]]; then
                        skip=1
                        continue
                    fi
                    skip=0
                fi
            fi

            (( skip )) && continue
            printf '%s\n' "$line" >> "$tmp"
        done < "$CONFIG_FILE"
    fi

    [[ ! -s $tmp ]] || printf '\n' >> "$tmp"
    cat >> "$tmp" <<EOF
[$name]
host=$(quote_config_value "$input_host")
remote_dir=$(quote_config_value "$input_remote_dir")
EOF
    mv -- "$tmp" "$CONFIG_FILE"
}

load_named_remote_defaults() {
    local name="$1"
    local line raw header len section="" found=0

    host=""
    remote_dir=""
    [[ -f "$CONFIG_FILE" ]] || return 1

    while IFS= read -r line || [[ -n $line ]]; do
        line=$(trim "$line")
        [[ -z $line || ${line:0:1} == '#' ]] && continue

        header=${line%%#*}
        header=$(trim "$header")
        if [[ ${header:0:1} == '[' ]]; then
            len=${#header}
            [[ $len -ge 3 && ${header:$((len-1)):1} == ']' ]] || die "malformed remote section header in $CONFIG_FILE: $line"
            section=${header:1:$((len-2))}
            section=$(trim "$section")
            validate_remote_name "$section"
            [[ $section == "$name" ]] && found=1 || found=0
            continue
        fi

        (( found )) || continue
        case "$line" in
            host=*)
                raw=${line#host=}
                host=$(parse_config_value "$raw")
                ;;
            remote_dir=*)
                raw=${line#remote_dir=}
                remote_dir=$(parse_config_value "$raw")
                ;;
        esac
    done < "$CONFIG_FILE"

    [[ -n $host || -n $remote_dir ]]
}

load_config() {
    local line raw header len section=""
    local top_host="" top_remote_dir=""
    local selected_host="" selected_remote_dir="" selected_found=0
    local section_count=0 section_names="" seen_sections=$'\n'
    local only_name="" only_host="" only_remote_dir=""

    [[ -f "$CONFIG_FILE" ]] || die "no $CONFIG_FILE found. Run '$PROGRAM init' first"

    host=""
    remote_dir=""
    config_remote=""

    while IFS= read -r line || [[ -n $line ]]; do
        line=$(trim "$line")
        [[ -z $line || ${line:0:1} == '#' ]] && continue

        header=${line%%#*}
        header=$(trim "$header")
        if [[ ${header:0:1} == '[' ]]; then
            len=${#header}
            [[ $len -ge 3 && ${header:$((len-1)):1} == ']' ]] || die "malformed remote section header in $CONFIG_FILE: $line"
            section=${header:1:$((len-2))}
            section=$(trim "$section")
            validate_remote_name "$section"

            case "$seen_sections" in
                *$'\n'"$section"$'\n'*) die "duplicate remote '$section' in $CONFIG_FILE" ;;
            esac
            seen_sections="$seen_sections$section"$'\n'

            section_count=$((section_count + 1))
            if [[ -z $section_names ]]; then
                section_names=$section
            else
                section_names="$section_names, $section"
            fi

            if (( section_count == 1 )); then
                only_name=$section
                only_host=""
                only_remote_dir=""
            fi
            [[ -n $remote_name && $section == "$remote_name" ]] && selected_found=1
            continue
        fi

        case "$line" in
            host=*)
                raw=${line#host=}
                if [[ -z $section ]]; then
                    top_host=$(parse_config_value "$raw")
                else
                    [[ $section == "$remote_name" ]] && selected_host=$(parse_config_value "$raw")
                    (( section_count == 1 )) && only_host=$(parse_config_value "$raw")
                fi
                ;;
            remote_dir=*)
                raw=${line#remote_dir=}
                if [[ -z $section ]]; then
                    top_remote_dir=$(parse_config_value "$raw")
                else
                    [[ $section == "$remote_name" ]] && selected_remote_dir=$(parse_config_value "$raw")
                    (( section_count == 1 )) && only_remote_dir=$(parse_config_value "$raw")
                fi
                ;;
        esac
    done < "$CONFIG_FILE"

    if [[ -n $remote_name ]]; then
        (( selected_found )) || die "remote '$remote_name' not found in $CONFIG_FILE${section_names:+ (available: $section_names)}"
        [[ -n $selected_host ]] || die "'host' not set for remote '$remote_name' in $CONFIG_FILE"
        [[ -n $selected_remote_dir ]] || die "'remote_dir' not set for remote '$remote_name' in $CONFIG_FILE"
        host=$selected_host
        remote_dir=$selected_remote_dir
        config_remote=$remote_name
        return 0
    fi

    if [[ -n $top_host || -n $top_remote_dir ]]; then
        [[ -n $top_host ]] || die "'host' not set in $CONFIG_FILE"
        [[ -n $top_remote_dir ]] || die "'remote_dir' not set in $CONFIG_FILE"
        host=$top_host
        remote_dir=$top_remote_dir
        return 0
    fi

    if (( section_count == 1 )); then
        [[ -n $only_host ]] || die "'host' not set for remote '$only_name' in $CONFIG_FILE"
        [[ -n $only_remote_dir ]] || die "'remote_dir' not set for remote '$only_name' in $CONFIG_FILE"
        host=$only_host
        remote_dir=$only_remote_dir
        config_remote=$only_name
        return 0
    fi

    if (( section_count > 1 )); then
        die "multiple remotes in $CONFIG_FILE; pass --remote NAME (available: $section_names)"
    fi

    die "'host' not set in $CONFIG_FILE"
}

quote_config_value() {
    local value="$1"
    value=${value//\'/\'\\\'\'}
    printf "'%s'" "$value"
}

require_local_tools() {
    local tool
    for tool in "$@"; do
        command -v "$tool" >/dev/null 2>&1 || die "missing required command: $tool"
    done
}

shell_join() {
    local joined="" word

    for word in "$@"; do
        # rsync's -e parser preserves a quote inside a quoted word by doubling it.
        word=${word//\'/\'\'}
        joined="${joined}${joined:+ }'$word'"
    done

    printf '%s' "$joined"
}

prepare_ssh_options() {
    [[ ${#SSH_OPTS[@]} -eq 0 ]] || return 0

    local previous_umask

    require_local_tools ssh mkdir chmod
    if [[ -z $SSH_CONTROL_DIR ]]; then
        [[ -n ${HOME:-} ]] || die "HOME is not set; set EASY_SSH_CONTROL_DIR explicitly"
        SSH_CONTROL_DIR="$HOME/.ssh/easy-ssh-control"
    fi

    previous_umask=$(umask)
    umask 077
    mkdir -p -- "$SSH_CONTROL_DIR"
    umask "$previous_umask"
    chmod 700 "$SSH_CONTROL_DIR"

    SSH_OPTS=(
        -o BatchMode=yes
        -o ConnectTimeout="$SSH_CONNECT_TIMEOUT"
        -o ControlMaster=auto
        -o ControlPersist="$SSH_CONTROL_PERSIST"
        -o "ControlPath=\"$SSH_CONTROL_DIR/%C\""
    )
    RSYNC_SSH=$(shell_join ssh "${SSH_OPTS[@]}")
}

ensure_ssh_connection() {
    prepare_ssh_options
    ssh "${SSH_OPTS[@]}" "$host" true >/dev/null 2>&1 || die "ssh connection to '$host' failed"
}

resolve_remote_dir() {
    local create_remote=${1:-0}

    prepare_ssh_options

    remote_dir_real=$(ssh "${SSH_OPTS[@]}" "$host" bash -s -- "$remote_dir" "$create_remote" <<'EOF'
set -euo pipefail

dir=$1
create_remote=${2:-0}

if [[ "$dir" == '~' ]]; then
    dir=$HOME
elif [[ "$dir" == '~/'* ]]; then
    dir="$HOME/${dir#~/}"
fi

if [[ "$create_remote" == "1" ]]; then
    mkdir -p -- "$dir"
fi

printf '%s\n' "$dir"
EOF
) || die "failed to resolve remote_dir '$remote_dir' on '$host'"
}

check_local_size() {
    local force=${1:-0}
    local size_kb size_mb limit_mb size_bytes=""
    local tmpdir stats line rc

    tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/easy-ssh-size.XXXXXX") || \
        die "failed to create temporary directory for sync-size check"
    set +e
    stats=$(LC_ALL=C rsync "${RSYNC_SIZE_ARGS[@]}" --dry-run --stats ./ "$tmpdir/" 2>/dev/null)
    rc=$?
    set -e
    rm -rf -- "$tmpdir"
    (( rc == 0 )) || die "failed to calculate effective sync size with rsync"

    while IFS= read -r line; do
        if [[ $line =~ ^Total\ file\ size:\ ([0-9,]+)\ (B|bytes)$ ]]; then
            size_bytes=${BASH_REMATCH[1]//,/}
            break
        fi
    done <<< "$stats"
    [[ -n $size_bytes ]] || die "failed to read effective sync size from rsync"
    size_kb=$(((size_bytes + 1023) / 1024))

    if (( size_kb <= SIZE_WARN_KB )); then
        return 0
    fi

    size_mb=$(((size_kb + 1023) / 1024))
    limit_mb=$(((SIZE_WARN_KB + 1023) / 1024))

    if (( force )); then
        warn "effective sync size is ${size_mb}MB (> ${limit_mb}MB); continuing because --force was given"
        return 0
    fi

    die "effective sync size is ${size_mb}MB (> ${limit_mb}MB). Refusing to sync; add $IGNORE_FILE entries or re-run with --force"
}

build_rsync_args() {
    local pattern

    prepare_ssh_options
    RSYNC_ARGS=(-avz -e "$RSYNC_SSH")
    RSYNC_SIZE_ARGS=(-az)

    for pattern in "${DEFAULT_EXCLUDES[@]}"; do
        RSYNC_ARGS+=("--exclude=$pattern")
        RSYNC_SIZE_ARGS+=("--exclude=$pattern")
    done

    if [[ -f "$IGNORE_FILE" ]]; then
        RSYNC_ARGS+=("--filter=:- $IGNORE_FILE")
        RSYNC_SIZE_ARGS+=("--filter=:- $IGNORE_FILE")
    fi
}

prune_default_remote_excludes() {
    local force=${1:-0}

    ssh "${SSH_OPTS[@]}" "$host" bash -s -- "$remote_dir_real" "$force" "${CLEANABLE_DEFAULT_EXCLUDES[@]}" <<'EOF'
set -euo pipefail

dir=$1
force=${2:-0}
shift 2

for name in "$@"; do
    path="$dir/$name"
    [[ -e "$path" ]] || continue

    if [[ "$force" == "1" ]]; then
        rm -rf -- "$path"
        printf 'removed default-excluded path: %s\n' "$path"
    else
        printf 'would remove default-excluded path: %s\n' "$path"
    fi
done
EOF
}

push_files() {
    local clean=${1:-0}
    local force=${2:-0}
    local dest

    require_local_tools ssh rsync mktemp
    load_config
    ensure_ssh_connection
    resolve_remote_dir 1
    build_rsync_args
    check_local_size "$force"

    dest="$host:$remote_dir_real/"

    if (( clean )); then
        if (( force )); then
            rsync "${RSYNC_ARGS[@]}" --delete ./ "$dest"
            prune_default_remote_excludes 1
        else
            rsync "${RSYNC_ARGS[@]}" --delete --dry-run ./ "$dest"
            prune_default_remote_excludes 0
            info "Preview only. Re-run with '--force' to apply deletions."
        fi
    else
        rsync "${RSYNC_ARGS[@]}" ./ "$dest"
    fi
}

validate_pull_path() {
    local path="$1"

    [[ -n $path ]] || die "pull requires a relative path"
    [[ $path != /* ]] || die "pull path must be relative to remote_dir"

    case "$path" in
        ..|../*|*/../*|*/..)
            die "pull path must stay inside remote_dir"
            ;;
    esac
}

do_init() {
    local current_host=""
    local current_remote_dir=""
    local input_host input_remote_dir

    [[ $# -eq 0 ]] || die "usage: $PROGRAM [--remote NAME] init"

    if [[ -n $remote_name ]]; then
        validate_remote_name "$remote_name"
        if load_named_remote_defaults "$remote_name"; then
            current_host=$host
            current_remote_dir=$remote_dir
        fi
    elif config_has_sections; then
        die "$CONFIG_FILE contains named remotes; use '$PROGRAM --remote NAME init' to add or update one"
    elif [[ -f "$CONFIG_FILE" ]]; then
        load_config
        current_host=$host
        current_remote_dir=$remote_dir
    fi

    printf 'SSH host'
    [[ -n $remote_name ]] && printf ' for remote %s' "$remote_name"
    [[ -n $current_host ]] && printf ' [%s]' "$current_host"
    printf ': '
    IFS= read -r input_host
    input_host=${input_host:-$current_host}

    printf 'Remote directory'
    [[ -n $current_remote_dir ]] && printf ' [%s]' "$current_remote_dir"
    printf ': '
    IFS= read -r input_remote_dir
    input_remote_dir=${input_remote_dir:-$current_remote_dir}

    [[ -n $input_host ]] || die "host is required"
    [[ -n $input_remote_dir ]] || die "remote directory is required"

    if [[ -n $remote_name ]]; then
        write_named_remote_config "$remote_name" "$input_host" "$input_remote_dir"
    else
        cat > "$CONFIG_FILE" <<EOF
host=$(quote_config_value "$input_host")
remote_dir=$(quote_config_value "$input_remote_dir")
EOF
    fi

    info "wrote $CONFIG_FILE"
    if [[ ! -f "$IGNORE_FILE" ]]; then
        info "tip: easy-ssh already skips .git and .venv; create $IGNORE_FILE for data, build outputs, or other local-only files"
    fi
}

do_push() {
    local clean=0 force=0 arg

    while [[ $# -gt 0 ]]; do
        arg=$1
        case "$arg" in
            --clean)
                clean=1
                ;;
            --force)
                force=1
                ;;
            -h|--help)
                usage
                return 0
                ;;
            *)
                die "unknown option for push: $arg"
                ;;
        esac
        shift
    done

    push_files "$clean" "$force"
}

run_remote_command() {
    local cmd="$1"
    local qdir full_cmd qfull rc

    printf -v qdir '%q' "$remote_dir_real"
    full_cmd="cd $qdir && $cmd"
    printf -v qfull '%q' "$full_cmd"

    set +e
    # qfull is intentionally expanded on the client after printf %q escaping.
    # shellcheck disable=SC2029
    ssh "${SSH_OPTS[@]}" "$host" "bash -l -c $qfull"
    rc=$?
    set -e

    return "$rc"
}

do_run() {
    local cmd=${1:-}

    [[ $# -eq 1 ]] || die "usage: $PROGRAM run \"<cmd>\""

    push_files 0 0
    run_remote_command "$cmd"
}

do_submit() {
    local cmd=${1:-}
    local qdir qlog qstatus qjobfile full_cmd qfull job_body launch_output rc

    [[ $# -eq 1 ]] || die "usage: $PROGRAM submit \"<cmd>\""

    push_files 0 0

    printf -v qdir '%q' "$remote_dir_real"
    printf -v qlog '%q' "$remote_dir_real/$LOG_FILE"
    printf -v qstatus '%q' "$remote_dir_real/$STATUS_FILE"
    printf -v qjobfile '%q' "$remote_dir_real/.easy-ssh-job.sh"
    full_cmd="cd $qdir && $cmd"
    printf -v qfull '%q' "$full_cmd"

    job_body=$(cat <<EOF
#!/usr/bin/env bash
set -uo pipefail
trap 'rm -f -- $qjobfile' EXIT
: > $qlog
echo "running:\$\$" > $qstatus
bash -l -c $qfull 2>&1 | tee $qlog
rc=\${PIPESTATUS[0]}
echo "\$rc" > $qstatus
exit "\$rc"
EOF
)

    set +e
    # The q* values and job_body intentionally instantiate this remote script locally.
    # shellcheck disable=SC2087
    launch_output=$(ssh "${SSH_OPTS[@]}" "$host" bash -s <<EOF
set -euo pipefail

status_path=$qstatus
job_file=$qjobfile

if [[ -f $qstatus ]]; then
    status_content=\$(<$qstatus)
    if [[ \$status_content == running:* ]]; then
        pid=\${status_content#running:}
        if kill -0 "\$pid" 2>/dev/null; then
            echo "error: easy-ssh job already running (pid \$pid)" >&2
            exit 1
        fi
    fi
fi

cat > $qjobfile <<'EASY_SSH_JOB'
$job_body
EASY_SSH_JOB
chmod +x $qjobfile

nohup bash $qjobfile >/dev/null 2>&1 < /dev/null &
echo "nohup:\$!"
EOF
)
    rc=$?
    set -e

    (( rc == 0 )) || return "$rc"

    info "submitted job via nohup (pid ${launch_output#nohup:})"

    info "log: $remote_dir_real/$LOG_FILE"
    info "status: $remote_dir_real/$STATUS_FILE"
}

do_logs() {
    local rc

    [[ $# -eq 0 ]] || die "usage: $PROGRAM [--remote NAME] logs"
    require_local_tools ssh tail
    load_config
    ensure_ssh_connection
    resolve_remote_dir 0

    set +e
    ssh "${SSH_OPTS[@]}" "$host" bash -s -- "$remote_dir_real" "$LOG_FILE" "$LOG_LINES" <<'EOF'
set -euo pipefail

dir=$1
log_name=$2
lines=$3
log_path="$dir/$log_name"

[[ -f "$log_path" ]] || {
    echo "error: no log file found at $log_path" >&2
    exit 1
}

tail -n "$lines" "$log_path"
EOF
    rc=$?
    set -e

    return "$rc"
}

do_monitor() {
    local rc

    [[ $# -eq 0 ]] || die "usage: $PROGRAM [--remote NAME] monitor"
    require_local_tools ssh
    load_config
    ensure_ssh_connection
    resolve_remote_dir 0

    info "monitoring $remote_dir_real/$LOG_FILE on $host  (Ctrl+C to detach)"

    set +e
    ssh "${SSH_OPTS[@]}" -t "$host" bash -s -- "$remote_dir_real" "$LOG_FILE" "$STATUS_FILE" <<'EOF'
set -euo pipefail

dir=$1
log_name=$2
status_name=$3
log_path="$dir/$log_name"
status_path="$dir/$status_name"

# Wait for log file to appear (job may still be starting)
for i in $(seq 1 30); do
    [[ -f "$log_path" ]] && break
    sleep 0.5
done

[[ -f "$log_path" ]] || {
    echo "error: no log file found at $log_path" >&2
    exit 1
}

# Stream log, check job status every 2 seconds, exit when done
tail -n +1 -f "$log_path" &
tail_pid=$!
trap "kill $tail_pid 2>/dev/null; exit" INT TERM

while true; do
    sleep 2
    if [[ -f "$status_path" ]]; then
        status_content=$(<"$status_path")
        if [[ $status_content =~ ^-?[0-9]+$ ]]; then
            # Job finished — give tail a moment to flush, then exit
            sleep 1
            kill $tail_pid 2>/dev/null || true
            echo ""
            if [[ $status_content -eq 0 ]]; then
                echo "✅ job finished (exit 0)"
            else
                echo "❌ job finished (exit $status_content)"
            fi
            exit "$status_content"
        fi
    fi
    # If tail died (log removed?), stop
    kill -0 $tail_pid 2>/dev/null || break
done
EOF
    rc=$?
    set -e

    return "$rc"
}

do_pull() {
    local path=${1:-}
    local parent_dir

    [[ $# -eq 1 ]] || die "usage: $PROGRAM pull <path>"

    validate_pull_path "$path"
    require_local_tools ssh rsync mkdir
    load_config
    ensure_ssh_connection
    resolve_remote_dir 0

    parent_dir=$(dirname "$path")
    mkdir -p -- "$parent_dir"
    rsync -avz -e "$RSYNC_SSH" "$host:$remote_dir_real/$path" "$path"
}

do_clean() {
    local force=0 arg

    while [[ $# -gt 0 ]]; do
        arg=$1
        case "$arg" in
            --force)
                force=1
                ;;
            -h|--help)
                usage
                return 0
                ;;
            *)
                die "unknown option for clean: $arg"
                ;;
        esac
        shift
    done

    require_local_tools ssh rsync
    load_config
    ensure_ssh_connection
    resolve_remote_dir 0
    build_rsync_args

    if (( force )); then
        rsync "${RSYNC_ARGS[@]}" --delete --existing --ignore-existing ./ "$host:$remote_dir_real/"
        prune_default_remote_excludes 1
    else
        rsync "${RSYNC_ARGS[@]}" --delete --dry-run --existing --ignore-existing ./ "$host:$remote_dir_real/"
        prune_default_remote_excludes 0
        info "Preview only. Re-run with '--force' to remove remote-only files."
    fi
}

do_status() {
    local rc

    [[ $# -eq 0 ]] || die "usage: $PROGRAM [--remote NAME] status"
    require_local_tools ssh
    load_config

    [[ -z $config_remote ]] || info "remote: $config_remote"
    info "host: $host"
    info "remote_dir: $remote_dir"

    ensure_ssh_connection
    resolve_remote_dir 0

    info "ssh: ok"
    info "resolved_remote_dir: $remote_dir_real"

    set +e
    ssh "${SSH_OPTS[@]}" "$host" bash -s -- "$remote_dir_real" "$STATUS_FILE" <<'EOF'
set -euo pipefail

dir=$1
status_name=$2
status_path="$dir/$status_name"

if [[ ! -d "$dir" ]]; then
    echo "job: remote directory does not exist yet"
    exit 0
fi

if [[ ! -f "$status_path" ]]; then
    echo "job: no submitted job status found"
    exit 0
fi

status_content=$(<"$status_path")

if [[ $status_content == running:* ]]; then
    pid=${status_content#running:}
    if kill -0 "$pid" 2>/dev/null; then
        echo "job: running (pid $pid)"
    else
        echo "job: stale running marker (pid $pid not found)"
    fi
elif [[ $status_content =~ ^-?[0-9]+$ ]]; then
    echo "job: finished (exit $status_content)"
else
    echo "job: unknown status '$status_content'"
fi
EOF
    rc=$?
    set -e

    return "$rc"
}

main() {
    local command

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -r|--remote)
                [[ $# -ge 2 ]] || die "missing value for $1"
                remote_name=$2
                validate_remote_name "$remote_name"
                shift 2
                ;;
            --remote=*)
                remote_name=${1#--remote=}
                validate_remote_name "$remote_name"
                shift
                ;;
            --)
                shift
                break
                ;;
            -h|--help|help)
                shift
                [[ $# -le 1 ]] || die "help accepts at most one topic"
                show_help "${1:-overview}"
                return 0
                ;;
            --help=*)
                [[ $# -eq 1 ]] || die "help accepts at most one topic"
                show_help "${1#--help=}"
                return 0
                ;;
            "")
                show_help overview
                return 0
                ;;
            -*)
                die "unknown global option: $1"
                ;;
            *)
                break
                ;;
        esac
    done

    command=${1:-}

    case "$command" in
        init)
            shift
            do_init "$@"
            ;;
        push)
            shift
            do_push "$@"
            ;;
        run)
            shift
            do_run "$@"
            ;;
        submit)
            shift
            do_submit "$@"
            ;;
        logs)
            shift
            do_logs "$@"
            ;;
        monitor)
            shift
            do_monitor "$@"
            ;;
        pull)
            shift
            do_pull "$@"
            ;;
        clean)
            shift
            do_clean "$@"
            ;;
        status)
            shift
            do_status "$@"
            ;;
        -h|--help|help)
            shift
            [[ $# -le 1 ]] || die "help accepts at most one topic"
            show_help "${1:-overview}"
            ;;
        "")
            show_help overview
            ;;
        *)
            die "unknown command: $command"
            ;;
    esac
}

: <<'EASY_SSH_SKILL_PAYLOAD'
__EASY_SSH_SKILL_BEGIN__
---
name: easy-ssh
description: >
  Runs local project code on remote machines through the easy-ssh CLI. Use when
  asked to execute on a server, submit a durable job, use a GPU or CPU cluster,
  sync or pull project files, inspect remote logs, or check remote job status.
---

# easy-ssh — Remote Execution

Run local project code on a remote server through SSH and rsync. Keep editing and
agent work local; submit compute to the configured host.

## Default rule

**Use `easy-ssh submit` for all substantive work. Use `easy-ssh run` only for a
trivial read-only probe that will finish in about 10 seconds.**

Compilation, tests, training, downloads, data processing, file writes, and loops
belong in `submit`, even when they are expected to be quick. A blocking `run` can
outlive the invoking tool timeout and leave an untracked remote process.

```bash
easy-ssh submit "<command>"
easy-ssh monitor
```

The submitted job runs under `nohup`; Ctrl+C or an SSH interruption only detaches
monitoring and does not stop the remote job.

## Prerequisites

- `ssh` and `rsync` are available locally. Check with `command -v ssh` and
  `command -v rsync`. On Debian/Ubuntu, install them with
  `sudo apt-get install openssh-client rsync`; on macOS, `ssh` is included and
  `brew install rsync` installs rsync when needed.
- Key-based, non-interactive SSH works for the configured host.
- The remote machine has `rsync`; verify with
  `ssh <host> 'command -v rsync'` and ask its administrator to install it if
  absent.

If `easy-ssh` is absent from `PATH`, use the canonical repository's HTTPS
download, validate it as Bash, and then install it; never pipe a download to a
shell:

```bash
# Repository: https://github.com/exAClior/easy-ssh
(
  set -eu
  tmp=$(mktemp)
  trap 'rm -f "$tmp"' EXIT
  curl -fL https://raw.githubusercontent.com/exAClior/easy-ssh/main/easy-ssh -o "$tmp"
  bash -n "$tmp"
  mkdir -p "$HOME/.local/bin"
  install -m 0755 "$tmp" "$HOME/.local/bin/easy-ssh"
)
export PATH="$HOME/.local/bin:$PATH"
```

Persist that PATH export in the active shell's startup file if necessary, then
verify with `easy-ssh --help`.

## Workflow

### 1. Inspect configuration

```bash
ls .easy-ssh.conf 2>/dev/null
```

A default remote uses:

```bash
host='<ssh-host>'
remote_dir='<remote-path>'
```

Multiple remotes use named sections:

```bash
[a800]
host='a800'
remote_dir='~/projects/mypackage'

[h100]
host='h100'
remote_dir='~/projects/mypackage'
```

- Put `--remote NAME` immediately after `easy-ssh` when selecting a named remote:
  `easy-ssh --remote h100 status`.
- One named remote is selected automatically.
- With multiple named remotes and no default, ask which remote to use before
  destructive or long-running work.
- If configuration is missing, ask for the SSH host, remote directory, and
  optional remote name, then run `easy-ssh init` or
  `easy-ssh --remote <name> init`.

### 2. Choose the operation

| Intent | Command |
|---|---|
| Substantive command | `easy-ssh submit "<cmd>"` |
| Stream submitted output | `easy-ssh monitor` |
| Snapshot recent output | `easy-ssh logs` |
| Check job and SSH state | `easy-ssh status` |
| Trivial read-only probe | `easy-ssh run "<cmd>"` |
| Sync only | `easy-ssh push` |
| Fetch an artifact | `easy-ssh pull <relative-path>` |
| Preview remote cleanup | `easy-ssh clean` |
| Apply remote cleanup | `easy-ssh clean --force` |

### 3. Submit and observe durable work

```bash
easy-ssh submit "python train.py --epochs 10"
easy-ssh monitor
easy-ssh status
easy-ssh logs
```

Treat control-channel and job state separately:

- A failed `status`, `logs`, or `monitor` connection does **not** imply job
  failure. Wait briefly and check again.
- Do not repeat an uncertain submission until `status` confirms whether a job is
  already running.
- Report a job as launched only after `submit` prints its PID.
- Report completion only from a final status/exit code, not from a dropped SSH
  connection.

### 4. Pull results

```bash
easy-ssh pull results/metrics.json
easy-ssh pull checkpoints/
```

Pull paths are relative to `remote_dir`; absolute paths and `..` are rejected.

## Connection behavior

`easy-ssh` waits up to 30 seconds for SSH connection and banner exchange by
default. It uses OpenSSH `ControlMaster=auto` and a 10-minute `ControlPersist` so
the preflight, path resolution, rsync, launch, and monitoring operations can
reuse one authenticated connection.

The control socket is stored in a private local directory. These settings are
configurable:

| Variable | Default | Purpose |
|---|---:|---|
| `EASY_SSH_CONNECT_TIMEOUT` | `30` | SSH connect/banner timeout in seconds |
| `EASY_SSH_CONTROL_PERSIST` | `10m` | Master connection lifetime |
| `EASY_SSH_CONTROL_DIR` | `~/.ssh/easy-ssh-control` | Private control socket directory |
| `EASY_SSH_SIZE_WARN_KB` | `512000` | Effective sync-size refusal threshold |
| `EASY_SSH_LOG_LINES` | `50` | Lines printed by `logs` |

For an intermittent proxied host, prefer a larger timeout over rapid repeated
connections. Do not add blind retries around `run` or `submit`, because their
remote outcome can be ambiguous.

## File exclusions

`.git`, `.venv`, `.easy-ssh.conf`, and `.easy-ssh-ignore` are always excluded.
Add project-specific local-only or generated paths to `.easy-ssh-ignore` using
gitignore-style patterns:

```text
__pycache__/
*.pyc
data/
node_modules/
target/
build/
dist/
```

`clean` is a dry run. Use `clean --force` only after reviewing its deletion list.
Cleanup removes remote-only contents but preserves the configured `remote_dir`
itself. If a disposable remote root must be deleted intentionally, independently
validate the exact host and resolved target before a separate explicit removal;
easy-ssh intentionally provides no broad remote-root removal command.

## Progressive CLI guidance

Load only the focused help needed for the current task:

```bash
easy-ssh --help getting-started
easy-ssh --help jobs
easy-ssh --help configuration
easy-ssh --help troubleshooting
```

`easy-ssh --help skill` emits this complete installable `SKILL.md`. Do not call it
after this skill is already loaded unless verifying or exporting the canonical
skill text.

## Reporting

- `run`: report output and exit code.
- `submit`: report the acknowledged PID and how to inspect it.
- `pull`: report the fetched local path.
- Transport failure: report it as a monitoring/control failure and preserve the
  distinction from detached job state.
__EASY_SSH_SKILL_END__
EASY_SSH_SKILL_PAYLOAD

main "$@"
